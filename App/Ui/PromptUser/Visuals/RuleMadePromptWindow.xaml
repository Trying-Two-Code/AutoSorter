<Window x:Class="App.Ui.PromptUser.RuleMadePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App.Ui.PromptUser.Visuals"
        mc:Ignorable="d"
        Title="Autosorter - " Height="160" Width="320"
        Background="Black"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed"
        AllowsTransparency="True"
        WindowStyle="None"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <Style x:Key="PromptButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <SolidColorBrush Opacity="0.7" Color="#131219"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Foreground="White" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top"
                   FontFamily="Bahnschrift"
                   FontSize="20">
            Create a rule?
            </TextBlock>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button 
                    Style="{StaticResource PromptButton}"
                    Click="OnYesPressed"
                    Background="LightGreen">Yes</Button>
                <Separator Opacity="0" Width="30"></Separator>
                <Button 
                    Style="{StaticResource PromptButton}"
                    Click="OnNoPressed"
                    Background="LightSalmon">No</Button>
                <!--Separator Opacity="0" Width="30"></Separator>
                <Button Width="30" Height="30" VerticalAlignment="Center" Click="OnNoPressed">Maybe Later</Button-->
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Separator VerticalAlignment="Top"></Separator>
            <TextBlock
                TextAlignment="Center"
                VerticalAlignment="Top"
                Padding="7"
                FontFamily="Bahnschrift"
                Foreground="White"
                FontSize="15"
                >Information:</TextBlock>
            <StackPanel 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" >
                <local:ExtraInfo InfoLabel="This Rule" Click="OnNewRuleInfoClicked" />
                <local:ExtraInfo InfoLabel="Files" Click="OnFileInfoClicked" />
                <local:ExtraInfo InfoLabel="Old Rules" Click="OnOldRuleInfoClicked" />
                <local:ExtraInfo InfoLabel="Settings" Click="OnSettingsClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
