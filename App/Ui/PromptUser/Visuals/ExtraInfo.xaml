<UserControl x:Class="App.Ui.PromptUser.Visuals.ExtraInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App.Ui.PromptUser.Visuals"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="100">
    <Grid>
        <Button
            Name="MainButton"
            Background="Black"
            MinWidth="60"
            Width="100">
            <TextBlock Name="LabelTextBlock" Foreground="White">See {something}</TextBlock>
        </Button>
    </Grid>
</UserControl>
