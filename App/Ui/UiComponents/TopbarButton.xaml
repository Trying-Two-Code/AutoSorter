<UserControl x:Class="App.Ui.UiComponents.TopbarButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App.Ui.UiComponents"
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="45">
    <Grid>
        <Button 
         x:Name="TopbarButtonInst"
         MaxHeight="45"
         MaxWidth="45"
         FontSize="10"
         Click="TopbarButtonInst_Click"
         Background="Transparent"
         BorderThickness="0">

            <Image 
                x:Name="StartStopButtonInstImage" 
                Height="45" 
                Width="45" 
                Source="/Ui/Assets/Visual/logo.ico"/>
        </Button>
    </Grid>
</UserControl>
