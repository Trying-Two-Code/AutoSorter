<Window x:Class="AutoSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoSorter"
        xmlns:components="clr-namespace:App.Ui.UiComponents"
        mc:Ignorable="d"
        Title="AutoSorter" 
        Height="450" 
        Width="800"
        Icon="/Ui/Assets/Visual/logo.ico"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Background>
        <SolidColorBrush Opacity="1.0" Color="White"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"></RowDefinition>
            <RowDefinition Height="113*"></RowDefinition>
            <RowDefinition Height="14*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Name="DEBUGGGERRR"></TextBlock>
        <components:TopbarButton
            x:Name="CloseButton"
            Grid.Row="0"
            Click="CloseButton_Click"/>
        <!--components:StartStopButton
            Grid.Row="1"
            Click="StartStopButton_Click"/-->
    </Grid>
</Window>
